  "entry_modes": {
    "normal": {
      "description": "Ask only the operating condition and geometry inputs needed for a standard adjoint run."
    },
    "advanced": {
      "description": "Use the editable advanced_settings, optimizer, and retry_profiles blocks below."
    },
    "debug": {
      "description": "Read a selected or latest failed run and report evidence without changing files or launching Fluent."
    }
  },
  "flow": {
    "velocity_m_s": 32.5,
    "altitude_m": 0.0,
    "angle_of_attack_deg": 2.0,
    "chord_m": 1.0,
    "reference_area_m2": 1.0,
    "reference_area_mode": "unit-span",
    "reference_span_m": 1.0,
    "target_y_plus": 1.0,
    "turbulence_intensity": 0.01
  },
  "completion": {
    "strict_adjoint_only": true,
    "drag_must_decrease": true,
    "lift_relative_tolerance": 0.002,
    "minimum_lift_ratio": 0.998,
    "require_stepwise_lift_to_drag_improvement": true,
    "performance_targets_enabled": true,
    "minimum_cumulative_cd_reduction": 0.005,
    "minimum_cumulative_ld_improvement": 0.002
  },
  "shape_guard": {
    "enabled": true,
    "profile": "balanced",
