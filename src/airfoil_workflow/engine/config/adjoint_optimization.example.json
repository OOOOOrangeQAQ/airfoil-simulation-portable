      "max_chord_relative_change": null,
      "max_le_displacement_over_chord": null,
      "max_te_displacement_over_chord": null,
      "max_cumulative_hausdorff_over_chord": null,
      "max_incremental_hausdorff_over_chord": null,
      "max_area_relative_change": null,
      "max_thickness_relative_change": null
    }
  },
  "optimization_run": {
    "accept_recovered_attempts": false,
    "strict_clean_morphing": true,
    "candidate_selection_policy": "first-pass",
    "force_stability": {
      "enabled": true,
      "iterations_per_block": 10,
      "max_iterations": 100,
      "relative_tolerance": 5e-6,
      "consecutive_blocks": 2
    },
    "max_accepted_design_steps": 12,
    "relative_cd_convergence": 0.0005,
    "consecutive_converged_steps": 2,
    "minimum_relative_drag_improvement": 5e-4,
    "geometry_change": {
      "minimum_displacement_over_chord": 1e-6
    },
    "numerical_uncertainty": {
      "engineering_floor": 5e-4,
      "required_repeats": 5,
      "run_independent_reloads": true,
      "aa_cd_values": []
