    "repair_on_profile_exhaustion": false,
    "repair_profiles": [
      {
        "name": "repair_rbf_5e_6",
        "tier": "repair",
        "design_iterations": 1,
        "flow_iterations": 1600,
        "adjoint_iterations": 500,
        "drag_step_percent": -0.000005,
        "morpher_method": "radial-basis-function",
        "post_design_flow_iterations": 10
      },
      {
        "name": "repair_rbf_2e_6",
        "tier": "repair",
        "design_iterations": 1,
        "flow_iterations": 1600,
        "adjoint_iterations": 500,
        "drag_step_percent": -0.000002,
        "morpher_method": "radial-basis-function",
        "post_design_flow_iterations": 10
      },
      {
        "name": "repair_rbf_1e_6",
        "tier": "repair",
        "design_iterations": 1,
        "flow_iterations": 1600,
        "adjoint_iterations": 500,
        "drag_step_percent": -0.000001,
        "morpher_method": "radial-basis-function",
        "post_design_flow_iterations": 10
      },
      {
        "name": "repair_direct_interpolation_1e_6",
        "tier": "repair",
        "design_iterations": 1,
        "flow_iterations": 1600,
        "adjoint_iterations": 500,
        "drag_step_percent": -0.000001,
        "morpher_method": "direct-interpolation",
        "post_design_flow_iterations": 10
      },
      {
        "name": "repair_polynomials_1e_6",
        "tier": "repair",
        "design_iterations": 1,
        "flow_iterations": 1600,
        "adjoint_iterations": 500,
        "drag_step_percent": -0.000001,
        "morpher_method": "polynomials",
        "post_design_flow_iterations": 10
      }
    ]
  },
  "cfd_qualification": {
    "grid_convergence": null,
    "note": "Populate grid_convergence with the PASS output of scripts/aggregate_grid_gci.py for production qualification."
  },
  "exports": {
    "required": true,
    "save_baseline_case_data": true,
    "save_optimized_case_data": true,
    "tecplot": {
      "baseline_file": "exports/baseline/baseline.plt",
      "optimized_file": "exports/optimized/optimized.plt",
      "surface_only": true,
      "surfaces": ["airfoil"],
      "variables": []
    },
    "ensight": {
      "baseline_prefix": "exports/baseline/baseline_ensight",
      "optimized_prefix": "exports/optimized/optimized_ensight",
      "variables": ["pressure", "velocity-magnitude", "x-velocity", "y-velocity"],
      "optimized_sensitivity_prefix": "exports/optimized/optimized_sensitivity_ensight",
      "export_sensitivity": false,
      "sensitivity_required": false
    },
    "sensitivity": {
      "optimized_file": "exports/optimized/optimized_shape_sensitivity.sens",
      "export_after_adjoint": true
    }
  },
  "iterations": {
    "flow": 1200,
    "adjoint": 350,
    "design": 1
  },
  "advanced_settings": {
    "solver": {
      "solver_type": "pressure-based",
      "time": "steady",
      "viscous_model": "k-omega-sst",
      "density": "ideal-gas",
      "viscosity": "sutherland",
      "boundary_topology": "velocity-inlet-pressure-outlet",
      "inlet_zone": "velocity_inlet",
      "outlet_zone": "pressure_outlet",
      "farfield_boundary_type": "velocity-inlet",
      "wall_zone": "airfoil",
      "farfield_zone": "velocity_inlet"
    },
    "solution_methods": {
      "pressure_velocity_coupling": "coupled",
      "flux_type": "Rhie-Chow: momentum based",
      "gradient": "least-squares-cell-based",
      "pressure": "second-order",
      "first_order_pressure": "standard",
      "momentum": "second-order-upwind",
      "turbulent_kinetic_energy": "second-order-upwind",
      "specific_dissipation_rate": "second-order-upwind"
    },
    "solution_controls": {
      "initialization": "standard",
      "courant_number": 2.0,
      "explicit_relaxation": {
        "pressure": 0.25,
        "momentum": 0.25
      },
      "limits": {
        "max_turb_visc_ratio": 100000.0
      },
      "flow_ramp": {
        "first_order_iterations": 100
      }
    },
    "residual_criteria": {
      "continuity": 1e-5,
      "x_velocity": 1e-5,
      "y_velocity": 1e-5,
      "k": 1e-5,
      "omega": 1e-5
    },
    "convergence_criteria": {
      "optimizer": 5e-4,
      "cd_change": 1e-5,
      "cl_change": 1e-5
    },
    "adjoint_solver": {
      "method": "balanced",
      "stabilization_second_scheme_iterations": 60,
      "residual_criteria": {
        "adjoint_continuity": 1e-5,
        "adjoint_x_velocity": 1e-4,
        "adjoint_y_velocity": 1e-5
      }
    },
    "design_tool": {
      "modifiable_zones": ["airfoil"],
      "x_control_points": 24,
      "y_control_points": 8,
      "morpher": {
        "method": "radial-basis-function",
        "constraint_method": "standard",
        "polynomials": {
          "preconditioning_standard": 10.0,
          "preconditioning_enhanced": 10.0,
          "mask_shape_sensitivity": true
        },
        "rbf": {
          "max_iterations": 10,
          "linear_solver_tolerance": 1e-5,
          "max_subiteration": 100,
          "number_of_modes": 40
        }
      },
      "shape_anchors": {
        "enabled": true,
        "mode": "endpoints-only",
        "max_anchor_displacement_over_chord": 0.0
      },
      "thickness_constraint": {
        "enabled": true,
        "clearance_percent_of_baseline_max_thickness": 5.0,
        "minimum_local_thickness_ratio": 0.90,
        "minimum_area_ratio": 0.95,
        "samples": 401
      },
      "control_region_source": "get-bounds-from-airfoil",
      "constraint_type": "geometry-audit"
    },
    "optimizer": {
      "objective": "minimize_cd",
      "constraint": "cl_not_lower_than_baseline_with_tolerance",
      "objective_strategy": "drag-with-lift-bound",
      "objective_row_order": ["cd", "cl"],
      "objective_binding_strategy": "auto",
      "drag_step_percent": -0.15,
      "lift_step_percent": 0.05,
      "lift_runtime_bound_ratio": 0.999,
      "lift_bound_tolerance_percent": 0.02,
      "lift_force_report_to_observable_factor": 1.0,
      "autosave_every_design_iterations": 1,
      "post_design_flow_iterations": 10,
      "min_orthogonal_quality": "fluent-default"
    }
  },
  "optimizer": {
    "design_iterations": 1,
    "flow_iterations": 1200,
    "adjoint_iterations": 350
